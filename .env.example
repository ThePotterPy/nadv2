# ── Variables de Entorno — NAD Constructora ───────────────────────────────────
# Archivo de referencia: configurá estos valores en Railway o como variables
# del entorno del sistema. El proyecto no carga archivos .env automáticamente.
# NUNCA subas credenciales reales al repositorio.

# Puerto del servidor (default: 3000)
PORT=3000

# Ruta privada del panel admin. Usá una ruta distinta en producción.
ADMIN_PATH=reemplazar-por-ruta-admin-no-predecible

# Contraseña inicial del admin (solo se usa al crear la DB por primera vez).
# En producción debe ser única y tener al menos 12 caracteres.
ADMIN_DEFAULT_PASS=reemplazar-por-contrasena-larga-y-unica

# Secreto para firmar las cookies de sesión.
# En producción debe ser aleatorio y tener al menos 32 caracteres.
# Podés generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-caracteres

# Entorno (development | production)
NODE_ENV=development

# Origen público canónico. Obligatorio/recomendado en producción para SEO
# y para validar el origen de las operaciones administrativas.
# SITE_URL=https://nadconstructora.com.py

# Cantidad de proxies confiables entre Internet y Node (Railway: normalmente 1)
TRUST_PROXY_HOPS=1

# Forzar cookie segura (se activa automáticamente con NODE_ENV=production)
# COOKIE_SECURE=true

# Directorios de datos. En producción DATA_DIR debe apuntar al volumen Railway.
# Podés omitir UPLOADS_DIR para usar DATA_DIR/uploads dentro del mismo volumen.
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads

# Sólo para una emergencia consciente; permite arrancar producción sin volumen.
# Los datos podrían perderse en cada deploy. No habilitar normalmente.
# ALLOW_EPHEMERAL_DATA=false
